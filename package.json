{
  "name": "yt-download-electron",
  "version": "0.0.0",
  "private": true,
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:vue": "vite build",
    "build:electron": "tsc -p tsconfig.json",
    "build": "npm run build:vue && npm run build:electron",
    "desktop:dev": "npm run build:electron && concurrently \"tsc -p tsconfig.json -w\" \"node scripts/dev.js\"",
    "desktop:build": "cross-env VITE_TARGET=desktop npm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "idb-keyval": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
